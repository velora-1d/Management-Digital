# Database Configuration (PostgreSQL / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/management_digital?sslmode=disable"

# Application Settings
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Management Digital MH As-Saodah"
ROOT_DOMAIN="santrix.my.id"

# Authentication & Security
JWT_SECRET="ganti_dengan_jwt_secret_acak_minimal_32_karakter_123456"

# Cloudflare R2 Storage (Opsional: Jika kosong/tidak valid otomatis fallback ke penyimpanan lokal /uploads/)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
R2_ENDPOINT=""
R2_PREFIX=""

# AI Service (Opsional)
SUMOPOD_AI_KEY=""
SUMOPOD_AI_BASE_URL="https://ai.sumopod.com/v1"

# Database Seeding
ALLOW_SEED="false"
